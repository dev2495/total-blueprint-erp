{
  "name": "frontend_v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/with-supported-node.sh env NEXT_DISABLE_CACHE=1 DISABLE_NEXT_WEBPACK_PERSISTENT_CACHE=1 next dev -H 0.0.0.0 -p 3000",
    "build": "./scripts/with-supported-node.sh sh -c 'node scripts/check-theme-tokens.mjs && node scripts/check-user-facing-version-labels.mjs && node scripts/clean-next-types.mjs && next typegen && tsc --noEmit && next build'",
    "start": "./scripts/with-supported-node.sh next start -H 0.0.0.0 -p 3000",
    "lint": "./scripts/with-supported-node.sh eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "./scripts/with-supported-node.sh sh -c 'node scripts/check-theme-tokens.mjs && node scripts/clean-next-types.mjs && next typegen && tsc --noEmit'",
    "help:docs": "node scripts/generate_help_docs.mjs",
    "help:visuals": "node scripts/generate_help_visual_assets.mjs",
    "help:refresh-current": "node scripts/refresh_current_help_content.mjs",
    "help:screenshots": "node scripts/capture_help_screenshots.mjs",
    "help:validate": "node scripts/validate_help_coverage.mjs",
    "nav:validate": "node scripts/validate_nav_routes.mjs",
    "test:qty-formula": "node scripts/test-qty-formula.mjs",
    "test:ui-version-privacy": "node scripts/check-user-facing-version-labels.mjs",
    "e2e:ui:green": "./scripts/with-supported-node.sh node scripts/run_release_green.mjs",
    "e2e:ui": "./scripts/with-supported-node.sh node scripts/run_ui_e2e.mjs",
    "e2e:ui:report": "./scripts/with-supported-node.sh playwright show-report ../.runtime/ui-e2e/html-report",
    "e2e:ui:artwork-domain": "./scripts/with-supported-node.sh node scripts/run_artwork_domain_signoff.mjs",
    "e2e:ui:gate": "./scripts/with-supported-node.sh env UI_E2E_REPORT_SUFFIX=gate playwright test --project=gate",
    "e2e:ui:mutations": "./scripts/with-supported-node.sh env UI_E2E_REPORT_SUFFIX=mutations playwright test --project=mutations",
    "e2e:ui:observations": "./scripts/with-supported-node.sh env UI_E2E_REPORT_SUFFIX=observations playwright test --project=observations",
    "theme:tokens": "node scripts/check-theme-tokens.mjs"
  },
  "engines": {
    "node": ">=18 <21"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/browser": "^8.53.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-table": "^8.21.3",
    "axios": "1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "1.2.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "js-cookie": "3.0.8",
    "lucide-react": "^0.562.0",
    "next": "15.5.23",
    "react": "^18",
    "react-day-picker": "^9.13.2",
    "react-dom": "^18",
    "react-hook-form": "^7.71.1",
    "react-intersection-observer": "^10.0.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "nanoid": "3.3.17"
  }
}

# Curated root allowlist: only unignore the deployable app repo contents.
/*
!/.gitignore
!/.github/
!/.github/**
!/.env.example
!/.env.development.example
!/.env.production.example
!/apps/
!/apps/**
!/config/
!/config/**
!/deploy/
!/deploy/**
!/docs/
!/docs/**
!/frontend_v2/
!/frontend_v2/**
!/manage.py
!/render.yaml
!/requirements.txt
!/scripts/
!/scripts/**
!/start_all.sh
!/start_servers.sh

# Secrets and local env files stay out of Git.
.env
.env.local
.env.*.local
frontend_v2/.env*

# Runtime, dependency, and build output.
.runtime/
venv/
venv_311/
frontend_v2/.next/
frontend_v2/.next_stale_*/
frontend_v2/next_stale_*/
frontend_v2/.frontend_pid
frontend_v2/.git.frontend-backup/
frontend_v2/node_modules/
frontend_v2/node_modules_old/
frontend/node_modules/
**/__pycache__/
*.py[cod]

# Local artifacts and scratch helpers.
.DS_Store
*.log
*.log.*
*.out
*.pid
trace.log
sample_output.txt
wc_perf.json
/phase_*.py
/verify_*.py
/test_*.py
/tmp_*.js

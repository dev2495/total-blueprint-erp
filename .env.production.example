DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-50-plus-char-random-secret
ALLOWED_HOSTS=api.totalpolyprint.com
CORS_ALLOWED_ORIGINS=https://app.totalpolyprint.com
CSRF_TRUSTED_ORIGINS=https://app.totalpolyprint.com
TIME_ZONE=Asia/Kolkata

DB_NAME=total_blueprint_erp
DB_USER=blueprint_admin
DB_PASSWORD=replace-db-password
DB_HOST=replace-db-host
DB_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://replace-redis-host:6379/0
CELERY_BROKER_URL=redis://replace-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://replace-redis-host:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840

STRICT_RBAC=True
ALLOW_ROLE_OVERRIDE=False

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None
JWT_COOKIE_DOMAIN=.totalpolyprint.com

EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=reports@totalpolyprint.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

BACKUP_LOCAL_DIR=.runtime/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-random-key
BACKUP_S3_BUCKET=replace-s3-bucket
BACKUP_S3_ENDPOINT=replace-s3-endpoint
BACKUP_S3_REGION=replace-s3-region
BACKUP_S3_ACCESS_KEY=replace-s3-access-key
BACKUP_S3_SECRET_KEY=replace-s3-secret-key
BACKUP_S3_PREFIX=db-backups/

DR_RESTORE_DRILL_COMMAND=
DR_SMOKE_TEST_COMMAND=venv_311/bin/python manage.py check --deploy

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_API_BASE_URL=https://api.totalpolyprint.com
NEXT_PUBLIC_APP_ENV=production

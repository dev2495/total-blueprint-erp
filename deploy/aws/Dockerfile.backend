FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        --fail https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        fontconfig \
        libfreetype6 \
        libjpeg62-turbo \
        libpq5 \
        libxml2 \
        libxslt1.1 \
        openssl \
        postgresql-client-16 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 tpp \
    && useradd --system --uid 10001 --gid tpp --create-home --home-dir /home/tpp tpp

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install --require-hashes -r /app/requirements.txt

COPY --chown=tpp:tpp . /app

RUN mkdir -p /var/data/media /var/log/tpp-erp /var/backups/tpp-erp /app/staticfiles \
    && chown -R tpp:tpp /var/data/media /var/log/tpp-erp /var/backups/tpp-erp /app/staticfiles

USER tpp

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; req=urllib.request.Request('http://127.0.0.1:8000/api/health/live/', headers={'Host':'erp.totalpolyprint.com','X-Forwarded-Proto':'https'}); urllib.request.urlopen(req, timeout=5).read()"

CMD ["sh", "-c", "python manage.py collectstatic --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --worker-class gthread --workers ${GUNICORN_WORKERS:-2} --threads ${GUNICORN_THREADS:-4} --timeout ${GUNICORN_TIMEOUT:-120} --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 200 --access-logfile - --error-logfile -"]

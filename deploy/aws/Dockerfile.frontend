FROM node:20-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1 \
    UI_API_BASE_URL=http://backend:8000

WORKDIR /app/frontend_v2
RUN chown node:node /app/frontend_v2

COPY --chown=node:node frontend_v2/package.json frontend_v2/package-lock.json ./
USER node
RUN npm ci

COPY --chown=node:node frontend_v2 ./
RUN npm run build

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "run", "start"]

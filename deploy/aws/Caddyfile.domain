erp.totalpolyprint.com {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	request_body {
		max_size 64MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Overwrite client-supplied values before exact-proxy gate throttling.
			header_up X-Real-IP {remote_host}
		}
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /healthz {
		respond "ok" 200
	}

	reverse_proxy 127.0.0.1:3000
}

http://3.6.77.159 {
	redir https://erp.totalpolyprint.com{uri} permanent
}

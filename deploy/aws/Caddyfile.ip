:80 {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	request_body {
		max_size 64MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /healthz {
		respond "ok" 200
	}

	reverse_proxy 127.0.0.1:3000
}
